# Postgres. `pnpm dev` uses this when set. OrbStack container `inboxly-pg` listens on 54330.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54330/inboxly

# Single toggle. true = realistic mailbox, no Google required.
DEMO_MODE=true

# Shown on the sign-in screen. Not a secret.
ACCOUNT_EMAIL=

# Corsair. Required for live Gmail/Calendar. Generate a KEK with: openssl rand -base64 32
CORSAIR_KEK=
CORSAIR_API_KEY=
CORSAIR_SIGNING_SECRET=
# A ck_dev_ key delivers through the browser to localhost. Do not set a public delivery URL.
PORT=3000

# Anthropic. Optional in demo; AI falls back to canned text when empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Better Auth. Leave blank to use the hardcoded tenant "demo" (no Google sign-in).
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/renew-watches
CRON_SECRET=

# Gmail push. Topic the Gmail API watches, and the OIDC audience Hub verifies.
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=

# Set true to expose /debug on a production deployment.
ENABLE_DEBUG=
