# Postgres. Required in production. `pnpm dev` starts Postgres in Docker when this is unset.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/mail

# Production must be false, or unset. `pnpm dev` uses a fake mailbox only when this is unset.
DEMO_MODE=false

# Corsair. Required for live Gmail/Calendar. Generate a KEK with: openssl rand -base64 32
CORSAIR_KEK=
CORSAIR_API_KEY=
CORSAIR_SIGNING_SECRET=
# A ck_dev_ key delivers through the browser to localhost. Do not set a public delivery URL.
PORT=3000

# Anthropic. Optional in demo; AI falls back to canned text when empty.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Better Auth. Required for Google sign-in.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron sends Authorization: Bearer $CRON_SECRET to /api/cron/renew-watches
CRON_SECRET=

# Gmail push. One topic for every user. Point the Pub/Sub subscription at the
# Gmail webhook URL on https://auth.corsair.dev. Hub delivers it to this app.
# The notification includes the Gmail address, and mail opens that person's mailbox.
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_AUDIENCE=
